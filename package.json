{
    "name":  "amiyo-go-app",
    "version":  "0.1.0",
    "private":  true,
    "packageManager":  "npm@10.8.2",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "workspaces":  [
                       "apps/*",
                       "packages/*"
                   ],
    "scripts":  {
                    "dev:api":  "npm --workspace @amiyo/api run dev",
                    "dev:worker":  "npm --workspace @amiyo/worker run dev",
                    "dev:mobile":  "npm --workspace @amiyo/mobile run start",
                    "build":  "node ./node_modules/typescript/bin/tsc -b tsconfig.json",
                    "type-check":  "node ./node_modules/typescript/bin/tsc -b tsconfig.json",
                    "test":  "npm run test --workspaces --if-present",
                    "lint":  "npm run lint --workspaces --if-present",
                    "prisma:generate":  "prisma generate",
                    "prisma:migrate:dev":  "prisma migrate dev",
                    "prisma:migrate:deploy":  "prisma migrate deploy",
                    "secret:scan":  "node scripts/secret-scan.mjs",
                    "dev":  "node scripts/dev.mjs",
                    "dev:all":  "node scripts/dev.mjs"
                },
    "devDependencies":  {
                            "@types/node":  "^20.14.10",
                            "prisma":  "^5.22.0",
                            "typescript":  "^5.5.4"
                        }
}
