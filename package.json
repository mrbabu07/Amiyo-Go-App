{
  "name": "amiyo-go-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace @amiyo/api run dev",
    "dev:worker": "npm --workspace @amiyo/worker run dev",
    "dev:mobile": "npm --workspace @amiyo/mobile run start",
    "build": "node ./node_modules/typescript/bin/tsc -b tsconfig.json",
    "type-check": "node ./node_modules/typescript/bin/tsc -b tsconfig.json",
    "test": "npm run build && npm run test:workspaces && node --test --test-concurrency=1 scripts/*.test.mjs",
    "test:workspaces": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "demo:users": "node scripts/seed-firebase-demo-users.mjs",
    "demo:setup": "node scripts/demo-setup.mjs",
    "openapi:generate": "npm run build --workspace @amiyo/contracts && node scripts/generate-openapi.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev.mjs",
    "migration:dry-run": "tsx scripts/migration/dry-run.ts",
    "migration:apply": "tsx scripts/migration/apply-plan.ts",
    "release:check": "node scripts/release-readiness.mjs",
    "smoke:load": "node scripts/load-smoke.mjs",
    "dev:firebase": "node scripts/firebase-dev.mjs",
    "test:firebase-emulator": "firebase emulators:exec --only auth --project amiyo-app \"node scripts/firebase-emulator-smoke.mjs\"",
    "test:firebase-auth-e2e": "npm run build --workspace @amiyo/api && firebase emulators:exec --only auth --project amiyo-app \"node scripts/firebase-auth-e2e.mjs\""
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/node": "^20.14.10",
    "firebase-tools": "15.25.1",
    "prisma": "^5.22.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
