{
  "name": "amiyo-go-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace @amiyo/api run dev",
    "dev:worker": "npm --workspace @amiyo/worker run dev",
    "dev:mobile": "npm --workspace @amiyo/mobile run start",
    "web": "node scripts/web.mjs",
    "build": "node ./node_modules/typescript/bin/tsc -b tsconfig.json",
    "type-check": "node ./node_modules/typescript/bin/tsc -b tsconfig.json && npm run type-check --workspace @amiyo/mobile",
    "test": "npm run build && npm run test:workspaces && node --test --test-concurrency=1 scripts/*.test.mjs",
    "test:workspaces": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "demo:users": "node scripts/seed-firebase-demo-users.mjs",
    "demo:setup": "node scripts/demo-setup.mjs",
    "openapi:generate": "npm run build --workspace @amiyo/contracts && node scripts/generate-openapi.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "audit:runtime": "npm audit --omit=dev --workspace @amiyo/api --audit-level=high && npm audit --omit=dev --workspace @amiyo/worker --audit-level=high",
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev.mjs",
    "migration:dry-run": "tsx scripts/migration/dry-run.ts",
    "migration:apply": "tsx scripts/migration/apply-plan.ts",
    "release:check": "node scripts/release-readiness.mjs",
    "release:deploy-env": "node scripts/deployment-env.mjs",
    "release:mobile-env": "node scripts/mobile-release-env.mjs",
    "release:mobile-evidence": "node scripts/mobile-device-evidence.mjs",
    "release:finance-evidence": "node scripts/finance-provider-evidence.mjs",
    "release:retention-evidence": "node scripts/retention-approval-evidence.mjs",
    "release:evidence-files": "node scripts/release-evidence-files.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "restore:verify": "node scripts/restore-verification.mjs",
    "smoke:load": "node scripts/load-smoke.mjs",
    "smoke:staging-preflight": "node scripts/staging-smoke-preflight.mjs",
    "smoke:marketplace": "node scripts/marketplace-smoke.mjs",
    "smoke:authenticated": "node scripts/authenticated-marketplace-smoke.mjs",
    "smoke:staging-authenticated": "node scripts/staging-authenticated-smoke.mjs",
    "dev:firebase": "node scripts/firebase-dev.mjs",
    "test:firebase-emulator": "firebase emulators:exec --only auth --project amiyo-app \"node scripts/firebase-emulator-smoke.mjs\"",
    "test:firebase-auth-e2e": "npm run build --workspace @amiyo/api && firebase emulators:exec --only auth --project amiyo-app \"node scripts/firebase-auth-e2e.mjs\"",
    "test:demo-auth": "firebase emulators:exec --only auth --project amiyo-app \"node scripts/demo-auth-smoke.mjs\"",
    "test:demo-role-db": "node --env-file=apps/api/.env scripts/demo-role-db-smoke.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "firebase-tools": "15.34.1",
    "prisma": "^7.10.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.88.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "node-forge": "1.4.2"
  }
}
