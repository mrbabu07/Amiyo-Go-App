{
  "expo": {
    "name": "Amiyo-Go",
    "slug": "amiyo-go",
    "scheme": "amiyogo",
    "version": "0.1.0",
    "icon": "./assets/amiyo-icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.amiyo.go",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/amiyo-adaptive-foreground.png",
        "backgroundColor": "#FAF7F0"
      }
    },
    "ios": {
      "bundleIdentifier": "com.amiyo.go",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/amiyo-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7F0",
          "image": "./assets/amiyo-adaptive-foreground.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#050B14",
            "image": "./assets/amiyo-adaptive-foreground.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Amiyo-Go to select marketplace images."
        }
      ],
      "expo-document-picker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Amiyo-Go to use the microphone for voice product search.",
          "speechRecognitionPermission": "Allow Amiyo-Go to recognize speech for voice product search."
        }
      ],
      "expo-notifications",
      "@sentry/react-native",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Amiyo-Go to scan invoice and parcel QR codes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-status-bar"
    ]
  }
}
