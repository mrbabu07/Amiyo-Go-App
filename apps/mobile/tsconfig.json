{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["react-native"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@amiyo/contracts": ["../../packages/contracts/src/index.ts"],
      "@amiyo/domain": ["../../packages/domain/src/index.ts"]
    }
  },
  "include": ["app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "expo-env.d.ts"]
}
