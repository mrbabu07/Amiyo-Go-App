{
  "name": "@amiyo/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "type-check": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-compiled-tests.mjs dist"
  },
  "dependencies": {
    "@amiyo/config": "file:../../packages/config",
    "@amiyo/contracts": "file:../../packages/contracts",
    "@amiyo/domain": "file:../../packages/domain",
    "@amiyo/observability": "file:../../packages/observability",
    "@prisma/client": "^7.10.1",
    "bullmq": "^6.4.2",
    "firebase-admin": "^14.2.0",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "tsx": "^4.16.2"
  }
}
