  },
  "dependencies": {
    "@amiyo/config": "file:../../packages/config",
    "@amiyo/contracts": "file:../../packages/contracts",
    "@amiyo/domain": "file:../../packages/domain",
    "@amiyo/observability": "file:../../packages/observability",
    "@prisma/client": "^5.22.0",
    "bwip-js": "4.10.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "rate-limit-redis": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "tsx": "^4.16.2"
