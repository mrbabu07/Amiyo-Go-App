generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleName {
  CUSTOMER
  VENDOR_OWNER
  VENDOR_MANAGER
  VENDOR_STAFF
  SUPPORT_AGENT
  FINANCE_ADMIN
  OPERATIONS_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  ANONYMIZED
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ShopStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum KycStatus {
  DRAFT
  SUBMITTED
  REVIEWING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ARCHIVED
}

enum InventoryMovementType {
  RECEIPT
  ADJUSTMENT
  RESERVATION
  RELEASE
  SALE
  RETURN
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum ParentOrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum VendorOrderStatus {
  PLACED
  ACCEPTED
  REJECTED
  PROCESSING
  READY_TO_SHIP
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  REQUIRES_ACTION
  AUTHORIZED
  CAPTURED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
  EXPIRED
}

enum ReturnStatus {
  REQUESTED
  REVIEWING
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  RECEIVED
  INSPECTED
  REFUND_PENDING
  REFUNDED
  CLOSED
}

enum ShipmentStatus {
  PENDING
  READY_TO_SHIP
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum DispatchStatus {
  PENDING
  DISPATCHED
  ACCEPTED
  FAILED
  CANCELLED
}

enum PayoutStatus {
  REQUESTED
  REVIEWING
  APPROVED
  PROCESSING
  PAID
  REJECTED
  FAILED
  CANCELLED
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

model User {
  id                String                   @id @default(uuid()) @db.Uuid
  legacyId          String?                  @unique @map("legacy_id")
  providerSubject   String?                  @unique @map("provider_subject")
  normalizedEmail   String?                  @unique @map("normalized_email")
  normalizedPhone   String?                  @unique @map("normalized_phone")
  status            UserStatus               @default(ACTIVE)
  lastLoginAt       DateTime?                @map("last_login_at") @db.Timestamptz(3)
  deletedAt         DateTime?                @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  profile           UserProfile?
  addresses         Address[]
  roles             UserRole[]
  refreshSessions   RefreshSession[]
  devices           Device[]
  pushTokens        PushToken[]
  deletionRequests  AccountDeletionRequest[]
  vendorMemberships VendorMember[]
  carts             Cart[]
  wishlists         Wishlist[]
  orders            Order[]
  stockAlerts       StockAlert[]
  couponRedemptions CouponRedemption[]
  reviews           Review[]
  questions         Question[]
  answers           Answer[]
  returnRequests    Return[]
  supportTickets    SupportTicket[]
  supportMessages   SupportMessage[]
  chatMessages      ChatMessage[]
  chatParticipations ChatParticipant[]
  notifications     Notification[]
  loyaltyAccount    LoyaltyAccount?

  @@map("users")
}

model UserProfile {
  userId           String   @id @map("user_id") @db.Uuid
  firstName        String?  @map("first_name")
  lastName         String?  @map("last_name")
  displayName      String?  @map("display_name")
  avatarStorageKey String?  @map("avatar_storage_key")
  locale           String   @default("en")
  currency         String   @default("BDT") @db.Char(3)
  preferences      Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_profiles")
}

model Address {
  id            String   @id @default(uuid()) @db.Uuid
  legacyId      String?  @unique @map("legacy_id")
  userId        String   @map("user_id") @db.Uuid
  label         String
  recipientName String   @map("recipient_name")
  phone         String
  line1         String
  line2         String?
  division      String
  district      String
  upazila       String?
  unionName     String?  @map("union_name")
  postalCode    String?  @map("postal_code")
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("addresses")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        RoleName         @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  providerRef String?   @map("provider_ref")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}

model Device {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  installationId String      @unique @map("installation_id")
  platform       String
  appVersion     String?     @map("app_version")
  revokedAt      DateTime?   @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  pushTokens     PushToken[]

  @@index([userId])
  @@map("devices")
}

model PushToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  deviceId  String    @map("device_id") @db.Uuid
  token     String    @unique
  provider  String
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  device    Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model AccountDeletionRequest {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  status       String    @default("requested")
  reason       String?
  requestedAt  DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  executeAfter DateTime  @map("execute_after") @db.Timestamptz(3)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(3)
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status, executeAfter])
  @@map("account_deletion_requests")
}

model Vendor {
  id              String                @id @default(uuid()) @db.Uuid
  legacyId        String?               @unique @map("legacy_id")
  legalName       String                @map("legal_name")
  displayName     String                @map("display_name")
  status          VendorStatus          @default(PENDING)
  version         Int                   @default(1)
  approvedAt      DateTime?             @map("approved_at") @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  members         VendorMember[]
  shops           VendorShop[]
  kycSubmissions  VendorKycSubmission[]
  bankAccounts    VendorBankAccount[]
  wallet          VendorWallet?
  payoutRequests  VendorPayoutRequest[]
  payouts         VendorPayout[]
  products        Product[]
  vendorOrders    VendorOrder[]
  commissionRules CommissionRule[]
  chatThreads     ChatThread[]
  categoryRequests VendorCategoryRequest[]

  @@index([status, createdAt])
  @@map("vendors")
}

model VendorMember {
  id          String                  @id @default(uuid()) @db.Uuid
  vendorId    String                  @map("vendor_id") @db.Uuid
  userId      String                  @map("user_id") @db.Uuid
  role        RoleName
  status      String                  @default("active")
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  vendor      Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  user        User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  permissions VendorStaffPermission[]

  @@unique([vendorId, userId])
  @@index([userId])
  @@map("vendor_members")
}

model VendorStaffPermission {
  memberId      String       @map("member_id") @db.Uuid
  permissionKey String       @map("permission_key")
  granted       Boolean      @default(true)
  member        VendorMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([memberId, permissionKey])
  @@map("vendor_staff_permissions")
}

model VendorShop {
  id               String        @id @default(uuid()) @db.Uuid
  legacyId         String?       @unique @map("legacy_id")
  vendorId         String        @map("vendor_id") @db.Uuid
  name             String
  slug             String        @unique
  status           ShopStatus    @default(DRAFT)
  description      String?
  logoStorageKey   String?       @map("logo_storage_key")
  bannerStorageKey String?       @map("banner_storage_key")
  settings         Json?
  version          Int           @default(1)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  vendor           Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  products         Product[]
  shopProducts     ShopProduct[]
  vendorOrders     VendorOrder[]

  @@index([vendorId, status])
  @@map("vendor_shops")
}

model VendorKycSubmission {
  id              String              @id @default(uuid()) @db.Uuid
  vendorId        String              @map("vendor_id") @db.Uuid
  status          KycStatus           @default(DRAFT)
  submittedAt     DateTime?           @map("submitted_at") @db.Timestamptz(3)
  reviewedAt      DateTime?           @map("reviewed_at") @db.Timestamptz(3)
  reviewedBy      String?             @map("reviewed_by") @db.Uuid
  rejectionReason String?             @map("rejection_reason")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  vendor          Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  documents       VendorKycDocument[]

  @@index([vendorId, status])
  @@map("vendor_kyc_submissions")
}

model VendorKycDocument {
  id           String              @id @default(uuid()) @db.Uuid
  submissionId String              @map("submission_id") @db.Uuid
  documentType String              @map("document_type")
  storageKey   String              @map("storage_key")
  mimeType     String              @map("mime_type")
  checksum     String
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  submission   VendorKycSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("vendor_kyc_documents")
}

model VendorBankAccount {
  id                  String    @id @default(uuid()) @db.Uuid
  vendorId            String    @map("vendor_id") @db.Uuid
  provider            String
  accountName         String    @map("account_name")
  accountNumberMasked String    @map("account_number_masked")
  encryptedPayload    Bytes     @map("encrypted_payload")
  isDefault           Boolean   @default(false) @map("is_default")
  verifiedAt          DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  vendor              Vendor    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  payoutRequests      VendorPayoutRequest[]

  @@index([vendorId])
  @@map("vendor_bank_accounts")
}

model VendorWallet {
  id        String              @id @default(uuid()) @db.Uuid
  vendorId  String              @unique @map("vendor_id") @db.Uuid
  currency  String              @default("BDT") @db.Char(3)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  vendor    Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  entries   VendorLedgerEntry[]

  @@map("vendor_wallets")
}

model VendorLedgerEntry {
  id             String          @id @default(uuid()) @db.Uuid
  walletId       String          @map("wallet_id") @db.Uuid
  direction      LedgerDirection
  amountMinor    BigInt          @map("amount_minor")
  currency       String          @default("BDT") @db.Char(3)
  entryType      String          @map("entry_type")
  referenceType  String          @map("reference_type")
  referenceId    String          @map("reference_id")
  idempotencyKey String          @unique @map("idempotency_key")
  metadata       Json?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  wallet         VendorWallet    @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@map("vendor_ledger_entries")
}

model VendorPayoutRequest {
  id            String         @id @default(uuid()) @db.Uuid
  vendorId      String         @map("vendor_id") @db.Uuid
  bankAccountId String         @map("bank_account_id") @db.Uuid
  amountMinor   BigInt         @map("amount_minor")
  currency      String         @default("BDT") @db.Char(3)
  status        PayoutStatus   @default(REQUESTED)
  requestedAt   DateTime       @default(now()) @map("requested_at") @db.Timestamptz(3)
  reviewedAt    DateTime?      @map("reviewed_at") @db.Timestamptz(3)
  reviewedBy    String?        @map("reviewed_by") @db.Uuid
  rejectionReason String?      @map("rejection_reason")
  version       Int            @default(1)
  vendor        Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  bankAccount   VendorBankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  payouts       VendorPayout[]

  @@index([vendorId, status])
  @@index([bankAccountId])
  @@map("vendor_payout_requests")
}

model VendorPayout {
  id          String              @id @default(uuid()) @db.Uuid
  vendorId    String              @map("vendor_id") @db.Uuid
  requestId   String              @map("request_id") @db.Uuid
  provider    String
  providerRef String?             @unique @map("provider_ref")
  amountMinor BigInt              @map("amount_minor")
  currency    String              @default("BDT") @db.Char(3)
  status      PayoutStatus        @default(PROCESSING)
  paidAt      DateTime?           @map("paid_at") @db.Timestamptz(3)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  vendor      Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  request     VendorPayoutRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([vendorId, createdAt])
  @@map("vendor_payouts")
}

model Category {
  id                String              @id @default(uuid()) @db.Uuid
  legacyId          String?             @unique @map("legacy_id")
  parentId          String?             @map("parent_id") @db.Uuid
  name              String
  slug              String              @unique
  description       String?
  status            String              @default("active")
  displayOrder      Int                 @default(0) @map("display_order")
  commissionRateBps Int                 @default(0) @map("commission_rate_bps")
  version           Int                 @default(1)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  parent            Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children          Category[]          @relation("CategoryTree")
  attributes        CategoryAttribute[]
  products          Product[]
  commissionRules   CommissionRule[]
  vendorRequests    VendorCategoryRequest[]

  @@index([parentId, displayOrder])
  @@map("categories")
}

model VendorCategoryRequest {
  id           String    @id @default(uuid()) @db.Uuid
  vendorId     String    @map("vendor_id") @db.Uuid
  categoryId   String    @map("category_id") @db.Uuid
  status       String    @default("pending")
  reason       String
  description  String?
  reviewedBy   String?   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewReason String?   @map("review_reason")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  vendor       Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([vendorId, categoryId])
  @@index([status, createdAt])
  @@map("vendor_category_requests")
}

model CategoryAttribute {
  id           String                    @id @default(uuid()) @db.Uuid
  categoryId   String                    @map("category_id") @db.Uuid
  key          String
  label        String
  dataType     String                    @map("data_type")
  required     Boolean                   @default(false)
  filterable   Boolean                   @default(false)
  displayOrder Int                       @default(0) @map("display_order")
  category     Category                  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options      CategoryAttributeOption[]

  @@unique([categoryId, key])
  @@map("category_attributes")
}

model CategoryAttributeOption {
  id           String            @id @default(uuid()) @db.Uuid
  attributeId  String            @map("attribute_id") @db.Uuid
  value        String
  label        String
  displayOrder Int               @default(0) @map("display_order")
  attribute    CategoryAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, value])
  @@map("category_attribute_options")
}

model Product {
  id                   String                   @id @default(uuid()) @db.Uuid
  legacyId             String?                  @unique @map("legacy_id")
  vendorId             String                   @map("vendor_id") @db.Uuid
  shopId               String                   @map("shop_id") @db.Uuid
  categoryId           String                   @map("category_id") @db.Uuid
  name                 String
  slug                 String                   @unique
  description          String?
  brand                String?
  status               ProductStatus            @default(DRAFT)
  dynamicAttributes    Json?                    @map("dynamic_attributes")
  version              Int                      @default(1)
  publishedAt          DateTime?                @map("published_at") @db.Timestamptz(3)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  vendor               Vendor                   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  shop                 VendorShop               @relation(fields: [shopId], references: [id], onDelete: Restrict)
  category             Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants             ProductVariant[]
  media                ProductMedia[]
  moderationEvents     ProductModerationEvent[]
  shopListings         ShopProduct[]
  stockAlerts          StockAlert[]
  cartItems            CartItem[]
  wishlistItems        WishlistItem[]
  orderItems           OrderItem[]
  campaignProducts     CampaignProduct[]
  flashSaleProducts    FlashSaleProduct[]
  reviews              Review[]
  questions            Question[]
  recommendationEvents RecommendationEvent[]

  @@index([categoryId, status, createdAt])
  @@index([vendorId, status])
  @@map("products")
}

model ProductVariant {
  id             String                 @id @default(uuid()) @db.Uuid
  productId      String                 @map("product_id") @db.Uuid
  sku            String                 @unique
  title          String
  attributes     Json?
  priceMinor     BigInt                 @map("price_minor")
  compareAtMinor BigInt?                @map("compare_at_minor")
  costMinor      BigInt?                @map("cost_minor")
  currency       String                 @default("BDT") @db.Char(3)
  active         Boolean                @default(true)
  version        Int                    @default(1)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  product        Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  media          ProductMedia[]
  inventory      InventoryItem?
  reservations   InventoryReservation[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([productId, active])
  @@map("product_variants")
}

model ProductMedia {
  id           String          @id @default(uuid()) @db.Uuid
  productId    String          @map("product_id") @db.Uuid
  variantId    String?         @map("variant_id") @db.Uuid
  storageKey   String          @map("storage_key")
  mediaType    String          @map("media_type")
  mimeType     String          @map("mime_type")
  width        Int?
  height       Int?
  altText      String?         @map("alt_text")
  displayOrder Int             @default(0) @map("display_order")
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, displayOrder])
  @@map("product_media")
}

model InventoryItem {
  id           String              @id @default(uuid()) @db.Uuid
  variantId    String              @unique @map("variant_id") @db.Uuid
  onHand       Int                 @default(0) @map("on_hand")
  reserved     Int                 @default(0)
  reorderLevel Int                 @default(0) @map("reorder_level")
  version      Int                 @default(1)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  variant      ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  movements    InventoryMovement[]

  @@map("inventory_items")
